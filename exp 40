
import cv2
import pytesseract

pytesseract.pytesseract.tesseract_cmd = r"C:\Users\s.rajeswarireddy\Downloads\chess project 1.mp4"

cap = cv2.VideoCapture("video.mp4")

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    text = pytesseract.image_to_string(gray)

    if text.strip():
        print(text)

    cv2.imshow("Video Text Extraction", frame)

    if cv2.waitKey(30) == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
