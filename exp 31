import cv2

img = cv2.imread(r"C:\Users\s.rajeswarireddy\Downloads\download.jpg", 0)

threshold_value = 127
max_value = 255

ret, result = cv2.threshold(
    img, threshold_value, max_value, cv2.THRESH_BINARY
)

cv2.imshow("Original Image", img)
cv2.imshow("Segmented Image", result)
cv2.waitKey(0)
cv2.destroyAllWindows()
