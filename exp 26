import cv2

cap = cv2.VideoCapture(r"C:\Users\s.rajeswarireddy\Downloads\download.jpg")
frames = []

while True:
    ret, frame = cap.read()
    if not ret:
        break
    frames.append(frame)

cap.release()

if frames:
    h, w = frames[0].shape[:2]
    out = cv2.VideoWriter('reverse.mp4',
                          cv2.VideoWriter_fourcc(*'mp4v'),
                          20, (w, h))

    for frame in reversed(frames):
        out.write(frame)

    out.release()

print("Reverse video created")
